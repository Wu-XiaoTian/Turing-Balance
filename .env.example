# ================================================
# 后端:远程数据库配置
# 在 supabase 创建项目后获取以下配置
# ================================================

# Supabase 项目 URL（Project URL）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase 匿名公钥（anon/public key）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase 服务端密钥（只放服务器端，不要暴露到前端）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

#Supabase 存储桶名称，用于用户上传的文件（默认：user-files）
SUPABASE_STORAGE_BUCKET=user-files

# ================================================
# AI 配置
# 火山引擎 ARK API Key (格式: ark-...)
# 可通过 ARK 平台调用多种 AI 模型进行 IQ/EQ 评估
# ================================================

NEXT_PUBLIC_AI_API_KEY=your_ark_api_key_here


# ================================================
# 前端:vercel 应用配置,软件将直接部署到对应的公网网址
#在 Vercel 仪表盘中设置以下环境变量
# ================================================
# 开发环境: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 生产部署: https://your-vercel-domain.vercel.app
#NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app